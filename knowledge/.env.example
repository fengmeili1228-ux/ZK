# ====================
# Model Source & Cache
# ====================
MINERU_MODEL_SOURCE=modelscope
# MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=./models/modelscope_cache
HF_HOME=./models/huggingface_cache

# ===================== MinerU API =====================
MINERU_API_TOKEN=your-mineru-api-token
MINERU_BASE_URL=https://mineru.net/api/v4

# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
OPEN_API_KEY=your-openai-or-dashscope-api-key
OPEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1

VL_MODEL=qwen3-vl-flash
ITEM_MODEL=qwen-flash

# ====================
# BGE Embedding Models
# ====================
BGE_M3_PATH=./models/BGE-M3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=True
BGE_RERANKER_LARGE=./models/bge-reranker-large
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1
ITEM_NAME_DIAG=1

# ====================
# 商品名对齐 / 检索兜底配置
# ====================
# 高/中置信度阈值（向量分数）
ITEM_NAME_HIGH_CONFIDENCE=0.65
ITEM_NAME_MID_CONFIDENCE=0.40
# 字符串相似度阈值（0~1），建议 0.80
ITEM_NAME_STRING_SIMILARITY_THRESHOLD=0.80
# 融合分数阈值（向量 + 字符串相似度加权）
ITEM_NAME_COMBINED_THRESHOLD=0.70
# 字符串相似度在融合中的权重
ITEM_NAME_STRING_WEIGHT=0.40
# 无商品名时是否启用宽范围内部检索兜底（true/false）
ENABLE_BROAD_SEARCH_FALLBACK=true
# 无商品名且内部无结果时，是否启用 Web 搜索兜底（企业私有化默认 false）
ENABLE_WEB_FALLBACK_WHEN_NO_ITEM=false
# 宽范围检索返回的最少文档数阈值，低于此值认为没有有效结果
BROAD_SEARCH_MIN_DOCS=1
# 开放性问题（general_question）在未命中商品名时，是否直接让大模型自主回答
ENABLE_DIRECT_LLM_FOR_GENERAL_QUESTION=true

# ====================
# 答案生成配置
# ====================
# 最终答案的最大中文字符数，通过 Prompt 控制生成长度（非强制截断）
MAX_ANSWER_CHARS=800

# ====================
# Embedding General
# ====================
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks_v1
ITEM_NAME_COLLECTION=kb_item_names_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
MONGO_URL=mongodb://username:password@localhost:27017
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=knowledge-base-v1

# ====================
# Other / MCP Services
# ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
